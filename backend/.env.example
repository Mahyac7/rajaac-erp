# Salin file ini menjadi .env lalu isi nilainya.

# Connection string PostgreSQL dari Supabase.
# Ambil di: Supabase Dashboard > Project Settings > Database > Connection string > URI
# GUNAKAN yang "Connection pooling" (port 6543) untuk aplikasi, contoh:
# postgresql://postgres.abcxyz:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Kunci rahasia untuk menandatangani JWT. WAJIB diganti dengan string acak yang panjang.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Port server (Railway mengisi otomatis; untuk lokal boleh 4000).
PORT=4000

# Domain frontend yang diizinkan (CORS). Pisahkan dengan koma bila lebih dari satu.
# Contoh: https://rajaac-erp.vercel.app
# Kosongkan saat development lokal untuk mengizinkan semua origin.
CORS_ORIGIN=
